{
    "compilerOptions": {
        "module": "es2015",
        "target": "es2022",
        "lib": ["es2022"],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "noImplicitAny": false,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "node",
        "skipLibCheck": true
    },
    "exclude": ["node_modules", "dist"],
    "include": ["./src/**/*"],
    "tsc-alias": {
        "verbose": false,
        "resolveFullPaths": true,
        "resolveFullExtension": "'.js' | '.mjs' | '.cjs'",
        "fileExtensions": {
            "inputGlob": "{js,jsx,mjs}",
            "outputCheck": ["js", "json", "jsx", "mjs"]
        }
    }
}
