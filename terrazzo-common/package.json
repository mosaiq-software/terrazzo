{
    "name": "@mosaiq/terrazzo-common",
    "version": "1.6.2",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "npm run prebuild && tsc",
        "prebuild": "npm run lint && npm run types",
        "prepublish-cleanup": "node ./scripts/pre-publish.mjs",
        "build:watch": "tsc -w",
        "lint": "eslint .",
        "types": "tsc --noemit",
        "update": "git fetch origin develop && git merge origin/develop",
        "publish:prod": "npm ci && npm run build && npm run prepublish-cleanup && npm publish ./dist"
    },
    "publishConfig": {
        "registry": "https://registry.mosaiq.dev"
    },
    "license": "UNLICENSED",
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/node": "^22.10.2",
        "eslint": "^9.21.0",
        "globals": "^16.0.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.24.1"
    }
}
