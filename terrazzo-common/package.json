{
    "name": "@mosaiq/terrazzo-common",
    "version": "1.6.2",
    "main": "index.js",
    "types": "index.d.ts",
    "type": "module",
    "scripts": {
        "build": "tsc && tsc-alias && npm run prepublish-cleanup",
        "build:watch": "npm run build && (concurrently \"tsc -w\" \"tsc-alias -w\")",
        "prepublish-cleanup": "node ./scripts/pre-publish.mjs",
        "lint": "eslint .",
        "types": "tsc --noemit",
        "update": "git fetch origin develop && git merge origin/develop",
        "publish:prod": "npm ci && npm run build && npm publish ./dist",
        "test": "echo \"No tests specified\" && exit 0",
        "test:watch": "echo \"No tests specified\" && exit 0",
        "test:coverage": "echo \"No tests specified\" && exit 0"
    },
    "publishConfig": {
        "registry": "https://registry.mosaiq.dev"
    },
    "license": "UNLICENSED",
    "dependencies": {
        "@blocknote/core": "^0.45.0",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/node": "^22.10.2",
        "eslint": "^9.21.0",
        "globals": "^16.0.0",
        "tsc-alias": "^1.8.16",
        "typescript-eslint": "^8.24.1"
    }
}
