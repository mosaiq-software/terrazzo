{
    "name": "terrazzo-ui",
    "version": "1.0.1",
    "type": "module",
    "scripts": {
        "test": "test",
        "preview": "vite preview",
        "start": "vite --port 8080 --strictPort --host",
        "start:open": "vite --port 8080 --open --strictPort",
        "build": "tsc -b && vite build",
        "build:prod": "npm ci && npm i @mosaiq/terrazzo-common@latest && npm run build && rm -rf /www/* && cp -r ./dist/* /www",
        "lint": "eslint .",
        "types": "tsc --noemit",
        "update": "git fetch origin develop && git merge origin/develop",
        "common:prod": "npm un @mosaiq/terrazzo-common && npm i @mosaiq/terrazzo-common@latest",
        "common:dev": "npm un @mosaiq/terrazzo-common && npm i ../terrazzo-common/dist"
    },
    "license": "UNLICENSED",
    "dependencies": {
        "@ashwamegh/react-link-preview": "^1.0.1",
        "@blocknote/code-block": "^0.45.0",
        "@blocknote/core": "^0.45.0",
        "@blocknote/mantine": "^0.45.0",
        "@blocknote/react": "^0.45.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mantine/code-highlight": "^8.3.4",
        "@mantine/core": "^8.3.4",
        "@mantine/hooks": "^8.3.4",
        "@mantine/modals": "^8.3.4",
        "@mantine/notifications": "^8.3.4",
        "@mosaiq/terrazzo-common": "file:../terrazzo-common/dist",
        "dotenv": "^17.2.3",
        "fuse.js": "^7.1.0",
        "mantine-contextmenu": "^7.17.1",
        "node-vibrant": "^4.0.3",
        "query-string": "^9.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-icons": "^5.4.0",
        "react-router-dom": "^7.0.1",
        "socket.io-client": "^4.8.1",
        "vite-plugin-svgr": "^4.5.0",
        "y-socket.io": "^1.1.3",
        "yjs": "^13.6.27"
    },
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@types/node": "^22.19.0",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/react-router": "^5.1.20",
        "@vitejs/plugin-react": "^5.1.0",
        "css-loader": "^7.1.2",
        "eslint": "^9.38.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.4.0",
        "postcss": "^8.4.49",
        "postcss-loader": "^8.1.1",
        "postcss-preset-mantine": "^1.17.0",
        "postcss-simple-vars": "^7.0.1",
        "style-loader": "^4.0.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.2",
        "vite": "^7.1.12",
        "vite-plugin-node-polyfills": "^0.24.0"
    }
}
