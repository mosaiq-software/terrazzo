{
    "name": "terrazzo",
    "private": true,
    "workspaces": [
        "terrazzo-common",
        "terrazzo-api",
        "terrazzo-ui",
        "terrazzo-db"
    ],
    "repository": "https://github.com/mosaiq-software/terrazzo.git",
    "scripts": {
        "start": "concurrently \"npm run build:common\" \"npm run start:api\" \"npm run start:ui\"",
        "start:api": "cd terrazzo-api && npm run start",
        "start:ui": "cd terrazzo-ui && npm run start",
        "build:common": "cd terrazzo-common && npm run build:watch",
        "build:common:once": "cd terrazzo-common && npm run build",
        "migrate:db": "cd terrazzo-db && npm run migrate:up",
        "pretty": "prettier --write \"./**/*.{ts,tsx,json}\"",
        "lint": "npm run lint:api && npm run lint:ui && npm run lint:common",
        "lint:api": "cd terrazzo-api && npm run lint",
        "lint:ui": "cd terrazzo-ui && npm run lint",
        "lint:common": "cd terrazzo-common && npm run lint",
        "types": "npm run types:api && npm run types:ui && npm run types:common",
        "types:api": "cd terrazzo-api && npm run types",
        "types:ui": "cd terrazzo-ui && npm run types",
        "types:common": "cd terrazzo-common && npm run types",
        "postinstall": "npm run build:common:once",
        "prepare": "husky",
        "before-push": "node ./scripts/before-push.mjs",
        "test:api": "cd terrazzo-api && npm run test",
        "test:ui": "cd terrazzo-ui && npm run test",
        "test:common": "cd terrazzo-common && npm run test",
        "test": "npm run test:api && npm run test:ui && npm run test:common",
        "create-migration": "cd terrazzo-db && npm run create-migration"
    },
    "devDependencies": {
        "concurrently": "^9.1.0",
        "husky": "^9.1.7",
        "prettier": "^3.5.3"
    }
}
